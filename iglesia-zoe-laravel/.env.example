APP_NAME="Iglesia Cristiana Zoe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# Initial password for the accounts ChurchSeeder creates on an empty database.
SEED_PASSWORD=
# Password for the *.prueba accounts AccessSeeder creates (local and staging only).
TEST_ACCOUNTS_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production uses Supabase Postgres:
# DB_CONNECTION=pgsql
# DB_URL=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Photos, videos and files live in Wasabi. Without WASABI_BUCKET they stay on the local disk.
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_REGION=us-central-1
WASABI_BUCKET=iglesia-cristiana-zoe
WASABI_ENDPOINT=https://s3.us-central-1.wasabisys.com
# Local development only: keep test files apart and trust a custom CA bundle.
WASABI_PREFIX=
WASABI_CA_BUNDLE=

# Two doors: servers sign in on the church site, administrators on the admin site.
ZOE_SITE_URL=https://iglesiacristianazoe.miacademiapreu.com
ZOE_ADMIN_URL=https://admi-iglesiazoe.miacademiapreu.com
ZOE_ADMIN_HOSTS=admi-iglesiazoe.miacademiapreu.com

# Live stream: OBS sends to the media server on the VPS (deploy/stream-setup.sh installs it).
STREAM_HOST=iglesiacristianazoe.miacademiapreu.com
STREAM_RECORDINGS=/var/lib/zoe-stream/grabaciones
STREAM_RETENTION_HOURS=72
STREAM_GRACE_MINUTES=15

# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web), with
# YouTube Data API v3 enabled. Authorised redirect URI: ZOE_ADMIN_URL + /admin/transmision/youtube/volver
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
